# syntax=docker/dockerfile:1.7
#
# Self-contained catapult-server build.
#
# Goals:
#   1. Keep the host clean: only Docker is required; the whole toolchain, all
#      native dependencies, and the build artifacts live inside the image.
#   2. No dependency on upstream (symbol/symbol) implicit assets:
#        - NOT FROM symbolplatform/symbol-server-build-base (prebuilt Docker Hub image)
#        - NOT using the conan.symbol.dev artifactory / @nemtech/stable recipes
#      Instead we use the "manual" build path (docs/BUILD-manual.md): every native
#      dependency is built from its canonical upstream source by
#      jenkins/catapult/installDepsLocal.py (boost -> archives.boost.io,
#      others -> github.com/{google,mongodb,zeromq,facebook,openssl}).
#   3. Reproducible: all dependency versions are locked in
#      jenkins/catapult/versions.properties.
#
# Build context MUST be the repository root (this file references both
# jenkins/catapult and client/catapult):
#   DOCKER_BUILDKIT=1 docker build -f client/catapult/Dockerfile.selfcontained -t nemtus/catapult-server:local .
#
# Base image / compiler choice:
#   Default is ubuntu:24.04 (LTS, supported into 2029) whose stock gcc-13 is
#   within catapult's supported compiler range (gcc 9..15). Older gcc is also
#   safer w.r.t. -Werror (new warnings tend to come with newer gcc).
#   If a build issue appears, fall back to the upstream-validated toolchain with
#   `UBUNTU_VERSION=25.10` (gcc-15, matches versions.properties `ubuntu = 25.10`).
#   Both stages share UBUNTU_VERSION so libstdc++ ABI stays consistent.
#   For production, pin by digest, e.g. `FROM ubuntu:24.04@sha256:<digest>`.

ARG UBUNTU_VERSION=24.04

############################ Stage 1: builder ############################
FROM ubuntu:${UBUNTU_VERSION} AS builder
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Build toolchain only. We deliberately do NOT install distro libssl/boost/etc.;
# catapult requires specific versions that installDepsLocal.py builds from source.
# (perl is required by OpenSSL's ./Configure; python3-yaml is the only third-party
# python module installDepsLocal.py needs -- see jenkins/catapult/requirements.txt.
# Installed via apt instead of pip because Ubuntu's system python is PEP 668
# externally-managed.)
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build pkg-config \
        git curl ca-certificates perl tar xz-utils python3 python3-yaml \
    && rm -rf /var/lib/apt/lists/*

# --- dependency layer ---------------------------------------------------------
# Copy ONLY jenkins/catapult first so that editing catapult source code does not
# invalidate this (expensive) layer. installDepsLocal.py imports only modules
# under jenkins/catapult and writes everything into --target (/opt/deps).
COPY jenkins/catapult /src/jenkins/catapult
RUN PYTHONPATH=/src/jenkins/catapult python3 /src/jenkins/catapult/installDepsLocal.py \
        --target /opt/deps \
        --versions /src/jenkins/catapult/versions.properties \
        --download --build

# --- catapult build -----------------------------------------------------------
# USE_CONAN defaults to OFF, so this is the manual build path (no conan remote).
COPY client/catapult /src/client/catapult
WORKDIR /src/client/catapult

# Licensing gate baked into the build (defense in depth + automatic in-image evidence):
# the image cannot be built from a tree containing Tech Bureau Commercial-licensed files,
# and the PASS report travels with the image as proof the gate held at build time. Placed
# BEFORE cmake/ninja so a source-scope violation fails fast without an expensive build.
RUN set -eu; \
    mkdir -p /opt/catapult/licenses; \
    if bash scripts/check-license-scope.sh > /opt/catapult/licenses/LICENSE-SCOPE-REPORT.txt 2>&1; then \
        cat /opt/catapult/licenses/LICENSE-SCOPE-REPORT.txt; \
    else \
        cat /opt/catapult/licenses/LICENSE-SCOPE-REPORT.txt; exit 1; \
    fi

# catapult's CMakeLists.txt requires a .git at the repo root (../../.git) and
# derives its version string from `git` (CMakeGlobalSettings.cmake). We copy only
# subtrees (not the monorepo .git) to keep the build context small, so synthesize a
# minimal repo at /src that satisfies the existence check and the version commands.
# Kept DETERMINISTIC and independent of the build's VCS ref on purpose: this layer
# sits above the expensive cmake/ninja layer, so referencing a changing VCS_REF here
# would bust the compile cache on every commit. The true source revision is carried
# losslessly by the OCI image.revision label in the runtime stage instead; the
# in-binary version string just shows this stable synthetic commit.
RUN cd /src && git init -q -b dev \
    && git -c user.email=build@nemtus.invalid -c user.name=nemtus-build \
           commit -q --allow-empty -m "self-contained build"

RUN mkdir _build && cd _build \
    && BOOST_ROOT=/opt/deps/boost cmake .. \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_PREFIX_PATH="/opt/deps/facebook;/opt/deps/google;/opt/deps/mongodb;/opt/deps/zeromq;/opt/deps/openssl" \
        -GNinja \
    && ninja -j"$(nproc)"

# --- collect artifacts + runtime shared libraries into a clean tree -----------
# Also bundle the license texts and third-party notices so the published image is
# self-describing for LGPL-3.0 compliance (license + corresponding-source pointer).
#
# The bundled library set is derived from what the built artifacts ASK FOR (their ELF
# NEEDED entries), then located wherever upstream happened to install it. Three earlier
# shapes of this step were wrong, each for its own reason, and the comment is long
# because every one of them failed silently or expensively:
#
#   1. Globbing `/opt/deps/<dep>/lib*/*.so*` assumed every dependency's libraries live in
#      a `lib*` SUBDIRECTORY. Upstream's installDepsLocal.py passes OpenSSL `--libdir`
#      equal to the prefix, so libcrypto.so* sits FLAT in `/opt/deps/openssl`. The glob
#      matched nothing, `2>/dev/null || true` swallowed it, and the image shipped having
#      never bundled OpenSSL at all — it only worked while catapult needed the same
#      SONAME the distro's openssl provides, until the 3 -> 4 bump ended that.
#   2. Requiring each dependency to yield at least one `.so` assumed every dependency HAS
#      one. `google` (googletest / benchmark) is static and test-only:
#      `/opt/deps/google/lib` holds `.a` files and cmake config and no `.so`. That turned
#      a correct build into a failed one.
#   3. Deriving the set from `ldd` output assumed the BUILDER can resolve these libraries.
#      It cannot — nothing sets LD_LIBRARY_PATH there and the binaries carry no RPATH — so
#      ldd reported "not found", the path-capturing pattern matched nothing, and the stage
#      bundled ZERO libraries.
#
# `objdump -p` reads NEEDED straight out of the ELF header, so it answers "what does this
# binary require" without needing to resolve anything. `find` then answers "where did
# upstream put it" without us encoding a layout. A SONAME that cannot be located anywhere
# is reported by name and fails the build; nothing is skipped quietly.
#
# Skipped on purpose: libraries the runtime stage installs from apt (libc, libstdc++,
# libgcc_s, libatomic, …) and catapult's own `libcatapult.*` / `libextension.*`, which are
# build outputs already staged above.
RUN set -eux; \
    mkdir -p /opt/catapult/bin /opt/catapult/lib /opt/catapult/deps /opt/catapult/resources /opt/catapult/licenses; \
    cp -aL _build/bin/*     /opt/catapult/bin/; \
    cp -aL _build/lib/*.so* /opt/catapult/lib/  2>/dev/null || true; \
    cp -aL resources/*      /opt/catapult/resources/ 2>/dev/null || true; \
    cp -aL COPYING.LESSER   /opt/catapult/licenses/LGPL-3.0.txt; \
    cp -aL LICENSE.txt      /opt/catapult/licenses/LICENSE.txt; \
    cp -aL THIRD_PARTY_NOTICES.md /opt/catapult/licenses/THIRD_PARTY_NOTICES.md; \
    : > /tmp/needed; \
    for f in /opt/catapult/bin/*; do \
        [ -f "${f}" ] || continue; \
        objdump -p "${f}" 2>/dev/null | awk '/NEEDED/ { print $2 }' >> /tmp/needed || true; \
    done; \
    sort -u /tmp/needed > /tmp/needed.u; \
    [ -s /tmp/needed.u ] || { echo "ERROR: no NEEDED entries found in any artifact; the build output is not what we expect" >&2; exit 1; }; \
    missing=''; \
    while read -r soname; do \
        case "${soname}" in \
            ld-linux*|libc.so.*|libm.so.*|libdl.so.*|librt.so.*|libpthread.so.*) continue ;; \
            libstdc++.so.*|libgcc_s.so.*|libatomic.so.*) continue ;; \
            libcatapult.*|libextension.*) continue ;; \
        esac; \
        src="$(find /opt/deps -name "${soname}" \( -type f -o -type l \) -print -quit 2>/dev/null)"; \
        if [ -z "${src}" ]; then missing="${missing} ${soname}"; continue; fi; \
        cp -aL "${src}" /opt/catapult/deps/; \
    done < /tmp/needed.u; \
    if [ -n "${missing}" ]; then \
        echo "ERROR: these SONAMEs are required by the built artifacts but were not found anywhere under /opt/deps:" >&2; \
        for s in ${missing}; do echo "  ${s}" >&2; done; \
        exit 1; \
    fi; \
    rm -f /tmp/needed /tmp/needed.u; \
    ls -1 /opt/catapult/deps | sed 's/^/bundled: /'

############################ Stage 2: runtime ############################
FROM ubuntu:${UBUNTU_VERSION} AS runtime
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Minimal runtime: the C++/atomic runtime libs (everything else was built from
# source in the builder stage and is copied below).
# Recent ubuntu images already ship a non-root user at UID 1000, so reuse it
# (creating another UID 1000 would fail with "UID 1000 is not unique"). Only
# create one if the image happens not to have it.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libstdc++6 libatomic1 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && if ! getent passwd 1000 >/dev/null; then useradd --uid 1000 -ms /bin/bash catapult; fi

COPY --from=builder /opt/catapult /opt/catapult

# Provenance / licensing metadata (OCI image-spec annotations). VCS_REF is the real
# upstream commit (the in-binary version string carries the synthetic build commit
# instead, see the builder stage). image.source + image.revision give the
# corresponding-source pointer required for LGPL-3.0 redistribution; the full
# third-party inventory is bundled at /opt/catapult/licenses/THIRD_PARTY_NOTICES.md.
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="catapult-server" \
      org.opencontainers.image.description="Symbol catapult server (self-contained build, no upstream prebuilt base image or conan remote)" \
      org.opencontainers.image.vendor="nemtus" \
      org.opencontainers.image.source="https://github.com/nemtus/symbol" \
      org.opencontainers.image.url="https://github.com/nemtus/symbol/tree/dev/client/catapult" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="${VCS_REF}" \
      org.opencontainers.image.licenses="LGPL-3.0-or-later" \
      org.opencontainers.image.documentation="https://github.com/nemtus/symbol/blob/dev/client/catapult/docs/PUBLISHING-COMPLIANCE.md"

# /opt/catapult/bin is on this path, not just PATH, because catapult's build emits its
# plugins as shared objects into _build/bin alongside the executables — so
# `cp -aL _build/bin/*` lands all 25 libcatapult.*.so / libextension.*.so there. They are
# real NEEDED entries of catapult.tools.nemgen and of the mongo plugins, and with only
# /opt/catapult/{lib,deps} on the path the loader could not find any of them.
#
# This was broken from the start and invisible: the companion
# `cp -aL _build/lib/*.so* /opt/catapult/lib/` silently copied nothing (there is no
# _build/lib), and nothing checked. The link check below is what surfaced it.
#
# Adding bin to the path rather than relocating the .so files keeps plugin discovery
# exactly as it is in the already-published image — catapult resolves plugins through the
# loader, and moving them could change which directory it finds them in.
ENV LD_LIBRARY_PATH=/opt/catapult/lib:/opt/catapult/deps:/opt/catapult/bin
ENV PATH=/opt/catapult/bin:$PATH

# Verify the published image actually is what it claims to be. This runs in the RUNTIME
# stage on purpose: only here do LD_LIBRARY_PATH, the distro packages installed above and
# whatever the builder staged into /opt/catapult coexist, which is the combination no
# earlier stage can check. Two separate failure modes are gated:
#
#   (1) UNRESOLVED — a binary has a shared library the image does not contain. Without
#       this gate the build goes green and every binary exits 127 on first run (this is
#       how `libcrypto.so.4: cannot open shared object file` shipped).
#
#   (2) SHADOWED — a library IS staged under /opt/catapult, but something resolves that
#       same SONAME from elsewhere (normally /usr/lib). That silently defeats the point of
#       a self-contained image: the binary then runs against the distro's build instead of
#       the version upstream pins in client/catapult/CMakeLists.txt.
#
#       This is not hypothetical. Until the staging fix in the builder stage, OpenSSL was
#       never copied at all — upstream's installDepsLocal.py passes `--libdir` equal to the
#       prefix, so libcrypto.so* lands flat in /opt/deps/openssl and the old `lib*/` glob
#       matched nothing. The image worked anyway only because catapult was built against
#       OpenSSL 3.6.2 while `ca-certificates` pulls in Ubuntu's openssl 3.0.13 — the same
#       SONAME, so the linker resolved it by coincidence. The 4.0.3 bump ended the
#       coincidence. Check (1) alone would NOT have caught that era; this one does.
#
# Only SONAMEs we actually ship are checked, so libc / libstdc++ / libgcc_s / libatomic
# legitimately keep resolving to the distro.
#
# `ldd` exits 0 even when entries are unresolved, so the greps are the real gates; its
# stderr is discarded only because bin/ also holds non-ELF files that ldd rejects noisily.
# Findings accumulate in a file and each loop reads from a file rather than a pipe, so
# there is no nested command substitution and no subshell to lose state in — this check
# gates publishing, so it is written to be obvious rather than clever.
RUN set -eu; \
    ls /opt/catapult/lib /opt/catapult/deps /opt/catapult/bin 2>/dev/null \
        | grep -E '\.so' | sort -u > /tmp/shipped; \
    echo "self-contained libraries: $(wc -l < /tmp/shipped)"; \
    : > /tmp/problems; \
    for f in /opt/catapult/bin/* /opt/catapult/lib/*.so* /opt/catapult/deps/*.so*; do \
        [ -f "${f}" ] || continue; \
        ldd "${f}" > /tmp/ldd 2>/dev/null || continue; \
        grep 'not found' /tmp/ldd | sed "s|^[[:space:]]*|UNRESOLVED  ${f}: |" >> /tmp/problems || true; \
        sed -n 's|^[[:space:]]*\([^[:space:]]*\.so[^[:space:]]*\) => \(/[^[:space:]]*\).*|\1 \2|p' \
            /tmp/ldd > /tmp/links; \
        while read -r soname path; do \
            grep -Fxq "${soname}" /tmp/shipped || continue; \
            case "${path}" in \
                /opt/catapult/*) ;; \
                *) echo "SHADOWED    ${f}: ${soname} => ${path}" >> /tmp/problems ;; \
            esac; \
        done < /tmp/links; \
    done; \
    if [ -s /tmp/problems ]; then \
        echo 'ERROR: runtime link check failed.' >&2; \
        echo '  UNRESOLVED = the image does not contain a library a binary needs (it would exit 127).' >&2; \
        echo '  SHADOWED   = a bundled library lost resolution to a copy outside /opt/catapult, so the' >&2; \
        echo '               image would run against that instead of the version upstream pins.' >&2; \
        sed 's/^/  /' /tmp/problems >&2; \
        exit 1; \
    fi; \
    rm -f /tmp/shipped /tmp/problems /tmp/ldd /tmp/links; \
    echo "runtime link check: all binaries resolve, and every bundled library wins resolution"

# Numeric USER avoids coupling to the image's default user name (ubuntu).
USER 1000
WORKDIR /opt/catapult

# bin/ contains catapult.server, catapult.broker, catapult.recovery and
# catapult.tools.* . The default entrypoint is the server, which takes a resources
# directory as its first argument, e.g.
#   docker run --rm -v "$PWD/userconfig:/cfg" <image> /cfg
# To run a different binary (e.g. a tool), OVERRIDE the entrypoint -- otherwise its
# name is passed to catapult.server as a resources path:
#   docker run --rm --entrypoint catapult.tools.addressgen <image> --count 1
#   docker run --rm --entrypoint catapult.tools.address    <image> --mode public --input <pubkeyhex>
ENTRYPOINT ["catapult.server"]
